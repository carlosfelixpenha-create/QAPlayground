{
  "name": "qaplayground",
  "version": "1.0.0",
  "description": "Criar uma aplicação web simples e 100% em português, voltada para testes manuais e automatizados. O ambiente servirá como um \"playground\" para profissionais e estudantes de QA explorarem cenários reais de validação de software.",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "test": "jest",
    "test:local": "jest --testPathIgnorePatterns=frontend/tests/e2e/playwright",
    "test:coverage": "jest --coverage",
    "test:coverage:strict": "jest --coverage --testPathIgnorePatterns=frontend/tests/e2e/playwright",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "install:browsers": "playwright install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlosfelixpenha-create/QAPlayground.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/carlosfelixpenha-create/QAPlayground/issues"
  },
  "homepage": "https://github.com/carlosfelixpenha-create/QAPlayground#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-fetch": "^3.3.2",
    "@types/node": "^25.2.2"
  }
}
